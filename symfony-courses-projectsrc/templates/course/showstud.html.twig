{% extends 'base.html.twig' %}

{% block title "Hello Course" %}

{% block body %}

<p> Paragraphe </p>
<table>
 <tr>
   <td>Cours</td>
   <td>{{ course.title }} </td>
  </tr>
  <tr>
    <td>code</td>
    <td>{{ course.codeNAF }} </td>
  </tr>
  <tr>
    <td>jour</td>
    <td>{{ course.day }}</td>
  </tr>
  <tr>
    <td>heure</td>
    <td>{{ course.hour }}</td>
  </tr>
</table>
<div class="col-xs-4">
  <h3>Students enrolled</h3>
  <ul class="list-group">
     {% for student in students %}
        <!-- preview a conditional on an added field to student: year  -->
        <li class="list-group-item">
           <a href="{{ path('student.show', {'id': student.id}) }}">
              {{ student.lastname}}
           </a>
        </li>
     {% end for %}
  </ul>
</div>
{% endblock %} 


