{% extends "base.html.twig" %}

{% block title "Cours suivi par cet etudiant" %}

{% block body %}

<p> Paragraphe </p>
<table>
 <tr>
   <td>Nom</td>
   <td>{{ student.lastname }} </td>
  </tr>
  <tr>
    <td>Email</td>
    <td>{{ student.email }} </td>
  </tr>
  <tr>
    <td>Code RNCP global</td>
    <td>{{ student.courseBlockRNCP }}</td>
  </tr> 
</table>

<table>
  {% for course in courses %}
  <tr>
    <td>{{ course.title }}</td>
    <td>{{ course.day }}</td>
    <td>{{ course.hour }}</td>
    <td>{{ course.codeNAF }}</td>
  </tr>
  {% endfor %}
</table>
{% endblock %} 


