{% extends 'base.html.twig' %}

{% block title %}Hello StudentController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Register a Student ✅</h1>

    Enter the entitled course title, code and local datetime
    {{ form_start(form) }}
      {{ form_row(form.lastname) }}
      {{ form_row(form.email) }}
      {{ form_row(form.status) }}

      {{ form_label(form.courses) }}
      {{ form_errors(form.courses) }}
      <ul>
        {% for courseField in form.courses %}
          <li>
             {{ form_errors(courseField) }}
             {{ form_widget(courseField) }}
          </li>
        {% endfor %}
      </ul>

    {{ form_end(form) }}
</div>
{% endblock %}
